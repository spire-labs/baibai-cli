{
  "name": "@baibai/cli",
  "version": "0.1.0",
  "description": "Trade on baibai from the command line.",
  "type": "module",
  "bin": {
    "baibai": "./dist/baibai.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spire-labs/baibai-cli.git"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/main.ts --target node --banner '#!/usr/bin/env node' --outfile dist/baibai.mjs && chmod +x dist/baibai.mjs",
    "check": "biome check . && tsc --project tsconfig.json --pretty false --noEmit && bun test",
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@walletconnect/sign-client": "2.21.0",
    "qrcode": "^1.5.4",
    "viem": "^2.46.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.2"
  }
}
